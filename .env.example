# ---------- modo ----------
# simulated: agentes determinísticos sin costo | openai: agentes reales
AGENT_MODE=simulated
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---------- embeddings y base vectorial ----------
# hash + local: todo funciona sin cuentas externas | openai + pinecone: producción
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE=local
PINECONE_API_KEY=
PINECONE_INDEX=ai-engineering-knowledge-hub
PINECONE_NAMESPACE=course
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---------- RAG ----------
CHUNK_SIZE=450
CHUNK_OVERLAP=50
TOP_K=6
BM25_WEIGHT=0.5
MAX_UPLOAD_MB=10

# ---------- infraestructura ----------
REDIS_URL=redis://localhost:6379
WORKER_POLL_TIMEOUT_SECONDS=5
JOB_TTL_SECONDS=86400
MAX_GRAPH_STEPS=24
MAX_REVISIONS=1
ADMIN_USERS=admin

# ---------- observabilidad ----------
OBSERVABILITY_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=ai-engineering-knowledge-hub
